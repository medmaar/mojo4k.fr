# Global headers for all pages
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Cache HTML pages for 1 hour (allow CDN revalidation)
/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

# Cache static assets aggressively (1 year)
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.webmanifest
  Cache-Control: public, max-age=86400

# Sitemap should be fresh
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400

# Robots should be fresh
/robots.txt
  Cache-Control: public, max-age=3600

# RSS feed
/feed.rss
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

# News and index sitemaps
/sitemap-news.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
